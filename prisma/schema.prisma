generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id                 String   @id @default(uuid())
  registrationNumber String   @unique
  name               String
  email              String   @unique
  cpf                String   @unique
  phone              String?
  birthDate          DateTime
  status             Boolean   @default(true)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  enrollments        Enrollment[]

  @@index([name])
}

model Plan {
  id              String   @id @default(uuid())
  name            String
  description     String?
  price           Float

  duration        Int
  durationType    PlanDurationType

  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  enrollments Enrollment[]
}

enum PlanDurationType {
  DAYS
  WEEKS
  MONTHS
}

model Enrollment {
  id        String   @id @default(uuid())

  studentId String
  planId    String

  startDate DateTime
  endDate   DateTime?

  status    EnrollmentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  plan    Plan    @relation(fields: [planId], references: [id])

  payments Payment[]

  @@index([studentId])
  @@index([status])
}

enum EnrollmentStatus {
  ACTIVE
  CANCELED
  EXPIRED
  SUSPENDED
}

model Payment {
  id           String        @id @default(uuid())

  enrollmentId String
  amount       Decimal

  dueDate      DateTime
  paidAt       DateTime?

  status       PaymentStatus @default(PENDING)

  createdAt    DateTime @default(now())

  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id])
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

model Employee {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         EmployeeRole
  active       Boolean       @default(true)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastLoginAt  DateTime?

  @@index([role])
}

enum EmployeeRole {
  ADMIN
  MANAGER
  RECEPTION
  TRAINER
}